```{r}

#get posteriors by taking a weighted average over all mu values

p_V_null_unprompted <- (L0_matrix_null %*% mu_grid$p_null_unprompted) * dMu
p_V_long_unprompted <- (L0_matrix_long %*% mu_grid$p_long_unprompted) * dMu

p_V_null_prompted <- (L0_matrix_null %*% mu_grid$p_null_prompted) * dMu
p_V_long_prompted <- (L0_matrix_long %*% mu_grid$p_long_prompted) * dMu

posterior <- rbind(
  data.frame(V = V_vals, Prob = p_V_null_unprompted, Utterance = "null"),
  data.frame(V = V_vals, Prob = p_V_long_unprompted, Utterance = "long"),
  data.frame(V = V_vals, Prob = p_V_null_prompted, Utterance = "null_prompt"),
  data.frame(V = V_vals, Prob = p_V_long_prompted, Utterance = "long_prompt")
)

```

```{r}

posterior <- posterior %>%
  mutate(
    Type = if_else(grepl("^null", Utterance), "null", "long"),
    Panel = if_else(Utterance %in% c("null", "long"),
                    "unprompted", "prompted")
  )

pm <- posterior %>%
  group_by(Utterance) %>%
  summarize(mean = sum(V * Prob) * dV, .groups = "drop")

pm <- pm %>%
  mutate(
    Type = if_else(grepl("^null", Utterance), "null", "long"),
    Panel = if_else(Utterance %in% c("null", "long"),
                    "unprompted", "prompted")
  )

posterior$Panel <- factor(posterior$Panel,
                          levels = c("unprompted", "prompted"))

pm$Panel <- factor(pm$Panel,
                   levels = c("unprompted", "prompted"))
```

