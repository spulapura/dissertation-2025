```{r}

dV <- diff(V_vals)[1]

prior_L0 <- function(mu, nu) {
  a <- mu*nu
  b <- (1-mu) * nu
  dbeta(V_vals, a, b)
}

likelihood_L0 <- function(R) {
  if(R == "null") rep(1, length(V_vals)) else V_vals
}

evidential <- function(mu, nu, R) {
  prior <- prior_L0(mu, nu)
  likelihood <- likelihood_L0(R)
  unnorm_posterior <- prior * likelihood
  Z <- sum(unnorm_posterior) * dV
  posterior <- unnorm_posterior / Z
  data.frame(V = V_vals, 
             Prior = prior, 
             Posterior = posterior,
             UnnormPosterior = unnorm_posterior,
             mu = mu, 
             nu = nu, 
             R = R)
}

kl_divergence <- function(p, q, eps = 1e-10) {
  mask <- p > 0
  sum(p[mask] * log(p[mask] / (q[mask] + eps))) * dV
}

```

